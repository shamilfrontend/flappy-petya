{
  "name": "flappy-petya-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:android": "tsc && VITE_BUILD_TARGET=android vite build",
    "preview": "vite preview",
    "check": "npm run lint",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "assets:webp": "node scripts/convert-webp.mjs",
    "cap:sync": "npm run build:android && npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "build:ios": "tsc && VITE_BUILD_TARGET=ios vite build"
  },
  "dependencies": {
    "@capacitor/app": "^7.0.1",
    "@capacitor/core": "^7.4.2",
    "@capacitor/haptics": "^7.0.5",
    "firebase": "^12.14.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/cli": "^7.4.2",
    "@capacitor/ios": "^7.4.2",
    "eslint": "^9.39.4",
    "eslint-config-flat-airbnb": "^0.4.0",
    "sharp": "^0.34.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0"
  }
}
