{
  "name": "flappy-petya-web",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:android": "tsc && VITE_BUILD_TARGET=android vite build",
    "preview": "vite preview",
    "check": "npm run lint && npm run test:coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "cap:sync": "npm run build:android && npx cap sync",
    "cap:open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.2",
    "@capacitor/haptics": "^7.0.5",
    "firebase": "^12.14.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/cli": "^7.4.2",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.4",
    "eslint-config-flat-airbnb": "^0.4.0",
    "eslint-plugin-vitest": "^0.5.4",
    "happy-dom": "^20.10.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8"
  }
}
